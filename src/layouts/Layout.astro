---
import  SpeedInsights  from "@vercel/speed-insights/astro"
import { profile } from '../data/profile';
import { defaultLang, langs, localePath, ogLocale, useTranslations, type Lang } from '../i18n';

interface LayoutProps {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang }: LayoutProps = Astro.props as LayoutProps;
const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://almogon.com');
const canonical = new URL(localePath(lang), site).href;
const ogImage = new URL('/og-image.png', site).href;

// Structured data so search engines understand who the page is about
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  worksFor: { '@type': 'Organization', name: profile.currentCompany },
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.university },
  address: { '@type': 'PostalAddress', addressCountry: profile.countryCode },
  url: site.href,
  email: `mailto:${profile.email}`,
  sameAs: [profile.linkedIn, profile.github],
  knowsLanguage: profile.spokenLanguages,
  knowsAbout: profile.keywords,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0e100f" />
    <link rel="canonical" href={canonical} />
    {langs.map((code) => <link rel="alternate" hreflang={code} href={new URL(localePath(code), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLang), site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/Lato/Lato-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Lato/Lato-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {langs.filter((code) => code !== lang).map((code) => <meta property="og:locale:alternate" content={ogLocale[code]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skipLink}</a>
    <SpeedInsights />
    <slot />
  </body>
</html>

<style is:global>
  /*
   * Breakpoints (CSS variables cannot be used inside media queries):
   *   phone   < 768px
   *   tablet  768px – 1023px
   *   desktop >= 1024px
   */
  :root {
    --background: #0e100f;
    --surface: #151816;
    --text: #ffffff;
    --text-grey: #cccccc;
    --text-muted: #a3a8a5;
    --font-sans: 'Lato', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    --space-xs: clamp(1rem, 2vw, 1.5rem);
    --space-sm: clamp(1.5rem, 3vw, 2rem);
    --space-md: clamp(2rem, 4vw, 3rem);
    --space-lg: clamp(3rem, 6vw, 4rem);
    --space-xl: clamp(4rem, 8vw, 6rem);
    --space-2xl: clamp(6rem, 10vw, 8rem);
    --section-spacing: var(--space-2xl);
    --c-blue: rgb(67 114 255);
    --raw-blue: 67 114 255;
    --c-green: rgb(0, 204, 0);
    --raw-green: 0 204 0;
    --c-yellow: rgb(255, 255, 0);
    --raw-yellow: 255 255 0;
    --c-orange: rgb(255, 102, 0);
    --raw-orange: 255 102 0;
    --c-red: rgb(204, 0, 0);
    --raw-red: 204 0 0;
    /* #cc0000 is only 3.2:1 on the background; use this lighter red for text */
    --c-red-text: rgb(255, 92, 92);
    --header-height: clamp(5rem, 10vw, 8rem);
    --section-gap: clamp(1.5rem, 3vw, 2.25rem);
    --anchor-offset: var(--header-height);
    --content-max: 1200px;
    --page-gutter: clamp(1rem, 5vw, 3rem);
    --radius-card: clamp(14px, 2vw, 20px);
    --card-padding-x: clamp(1.25rem, 3.5vw, 3rem);
    --card-padding-y: clamp(1.25rem, 2vw, 1.5rem);
    --h1: clamp(2.5rem, 10vw, 8rem);
    --h2: clamp(1.25rem, 5vw, 4rem);
    --h3: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* Minimal reset */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border: 0 solid;
  }
  ul,
  ol {
    list-style: none;
  }
  a {
    color: inherit;
    text-decoration: inherit;
  }
  button {
    font: inherit;
    color: inherit;
    background: none;
    cursor: pointer;
  }
  img,
  svg {
    display: block;
    max-width: 100%;
  }
  h1,
  h2,
  h3,
  h4 {
    font-size: inherit;
    font-weight: inherit;
  }

  html {
    font-family: var(--font-sans);
    line-height: 1.5;
    height: 100%;
    width: 100%;
    scroll-behavior: smooth;
    scroll-padding-top: var(--anchor-offset);
    -webkit-text-size-adjust: 100%;
  }
  body {
    min-height: 100%;
    width: 100%;
    background: var(--background);
    color: var(--text);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  :focus-visible {
    outline: 2px solid var(--accent-text, var(--text));
    outline-offset: 3px;
    border-radius: 4px;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 200;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--text);
    color: var(--background);
    font-weight: 700;
    transform: translateY(-200%);
    transition: transform 0.2s ease;
  }
  .skip-link:focus {
    transform: translateY(0);
  }

  /* Shared content column: header, hero and every section align to it */
  .container-section {
    width: 100%;
    max-width: calc(var(--content-max) + 2 * var(--page-gutter));
    padding-inline: var(--page-gutter);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Sections that list cards below their title */
  .section-list {
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--space-md);
  }

  .section-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .section-intro {
    color: var(--text-muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    line-height: 1.6;
    max-width: 60ch;
    margin-top: 0.75rem;
  }

  /* Accent color per section */
  .accent-blue { --accent: var(--c-blue); --accent-rgb: var(--raw-blue); --accent-text: var(--c-blue); }
  .accent-green { --accent: var(--c-green); --accent-rgb: var(--raw-green); --accent-text: var(--c-green); }
  .accent-yellow { --accent: var(--c-yellow); --accent-rgb: var(--raw-yellow); --accent-text: var(--c-yellow); }
  .accent-orange { --accent: var(--c-orange); --accent-rgb: var(--raw-orange); --accent-text: var(--c-orange); }
  .accent-red { --accent: var(--c-red); --accent-rgb: var(--raw-red); --accent-text: var(--c-red-text); }

  /* Shared card used by every section */
  .card-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
  }

  .card {
    width: 100%;
    border: 1px solid rgb(var(--accent-rgb, 255 255 255) / 0.8);
    border-radius: var(--radius-card);
    display: grid;
    grid-template-columns: 2fr 3fr;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.2);
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .card-single {
    grid-template-columns: 1fr;
  }

  .card:hover {
    background: rgb(var(--accent-rgb, 255 255 255) / 0.06);
    border-color: var(--accent);
    box-shadow: 0 28px 96px rgba(0, 0, 0, 0.24);
  }

  .card-pane {
    padding: var(--card-padding-y) var(--card-padding-x);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .card-pane-right {
    justify-content: center;
    gap: 0.5rem;
  }

  .card-eyebrow {
    color: var(--accent-text);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .card-title {
    font-size: var(--h3);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-grey);
  }

  .card-text {
    color: var(--text-grey);
    line-height: 1.6;
  }

  .card-body {
    color: var(--text-muted);
    line-height: 1.6;
  }

  .card-meta {
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.5rem);
    color: var(--text-grey);
  }

  .card-link {
    color: var(--text);
    opacity: 0.85;
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    overflow-wrap: anywhere;
    width: fit-content;
    max-width: 100%;
    border-bottom: 1px solid rgb(var(--accent-rgb, 255 255 255) / 0.35);
    transition: opacity 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .card-link:hover,
  .card-link:focus-visible {
    opacity: 1;
    color: var(--accent-text);
    border-color: var(--accent);
  }

  /* Pill tags (skills, tech stack) */
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.4;
    background: rgb(var(--accent-rgb) / 0.08);
    border: 1px solid rgb(var(--accent-rgb) / 0.3);
    color: var(--accent-text);
  }

  /* Buttons (calls to action) */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .btn:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--text);
    border-color: var(--text);
    color: var(--background);
  }

  .btn-primary:hover {
    background: var(--text-grey);
    border-color: var(--text-grey);
  }

  .btn svg {
    flex-shrink: 0;
  }

  /* Desktop: justified paragraphs (narrower columns get large word gaps) */
  @media (min-width: 1024px) {
    .card-text,
    .card-body {
      text-align: justify;
    }
  }

  /* Phone: stack the card panes */
  @media (max-width: 767px) {
    .card {
      grid-template-columns: 1fr;
    }
    .card-pane-right {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  @font-face {
    font-family: 'Lato';
    src: url('/fonts/Lato/Lato-Light.woff2') format('woff2');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Lato';
    src: url('/fonts/Lato/Lato-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Lato';
    src: url('/fonts/Lato/Lato-Bold.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Lato';
    src: url('/fonts/Lato/Lato-Black.woff2') format('woff2');
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }
</style>
