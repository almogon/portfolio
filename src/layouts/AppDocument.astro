---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from './Layout.astro';

// Standalone document of one of my apps (privacy policy, support…), outside the one-page cube.
// Trilingual pages: the sections in the slot carry their own `id` and `lang`.
interface Props {
  title: string;
  description: string;
  path: string;
  appName: string;
  icon: ImageMetadata;
  subtitle: string;
  sections: { href: string; label: string; hreflang?: string }[];
  updated?: string;
  owner: string;
}

const { title, description, path, appName, icon, subtitle, sections, updated, owner } = Astro.props as Props;
---

<Layout title={title} description={description} lang="es" path={path}>
  <header class="doc-header container-section accent-orange">
    <a class="back-link" href="/es/#apps">
      <span aria-hidden="true">←</span>
      almogon.com
    </a>
    <div class="app-title">
      <Image class="app-icon" src={icon} alt="" width={72} height={72} densities={[1, 2]} />
      <div>
        <h1>{appName}</h1>
        <p class="muted">{subtitle}</p>
      </div>
    </div>
    <nav class="section-nav" aria-label="Idioma / Sprache / Language">
      {
        sections.map((section) => (
          <a href={section.href} hreflang={section.hreflang}>
            {section.label}
          </a>
        ))
      }
    </nav>
    {
      updated && (
        <p class="muted">
          Última actualización / Letzte Aktualisierung / Last updated: <strong>{updated}</strong>
        </p>
      )
    }
  </header>

  <main id="main" tabindex="-1" class="doc container-section accent-orange">
    <slot />
  </main>

  <footer class="doc-footer container-section">
    <p>© {new Date().getFullYear()} {owner}</p>
    <a href="/es/#apps">almogon.com</a>
  </footer>
</Layout>

<style>
  /* Header, text and footer share one narrow reading column */
  .doc-header,
  .doc,
  .doc-footer {
    max-width: calc(820px + 2 * var(--page-gutter));
  }

  .doc-header {
    gap: var(--space-xs);
    padding-top: var(--space-md);
    padding-bottom: var(--space-sm);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    color: var(--text-muted);
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-text);
  }

  .app-title {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .app-icon {
    flex-shrink: 0;
    width: clamp(56px, 8vw, 72px);
    height: auto;
    border-radius: 22%;
    box-shadow: 0 0 0 1px rgb(var(--accent-rgb) / 0.45);
  }

  h1 {
    font-size: clamp(2.25rem, 7vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .muted {
    color: var(--text-muted);
  }

  .section-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-nav a {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent-text);
    background: rgb(var(--accent-rgb) / 0.08);
    border: 1px solid rgb(var(--accent-rgb) / 0.3);
    transition: background-color 0.2s ease;
  }

  .section-nav a:hover {
    background: rgb(var(--accent-rgb) / 0.18);
  }

  /* Content comes from the page through the slot, so it needs :global */
  .doc {
    padding-bottom: var(--space-lg);
    color: var(--text-grey);
    line-height: 1.7;
  }

  .doc :global(section) {
    padding-top: var(--space-md);
    scroll-margin-top: 1rem;
  }

  .doc :global(section + section) {
    margin-top: var(--space-md);
    border-top: 2px solid rgb(var(--accent-rgb) / 0.35);
  }

  .doc :global(h2) {
    color: var(--text);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .doc :global(h3) {
    color: var(--text);
    font-size: 1.1rem;
    font-weight: 700;
    margin: 1.75rem 0 0.5rem;
    scroll-margin-top: 1rem;
  }

  .doc :global(p + p) {
    margin-top: 0.75rem;
  }

  .doc :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0.5rem 0;
  }

  .doc :global(li) {
    position: relative;
    padding-left: 1.25rem;
  }

  .doc :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.5rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .doc :global(a) {
    color: var(--text);
    border-bottom: 1px solid rgb(var(--accent-rgb) / 0.5);
    overflow-wrap: anywhere;
  }

  .doc :global(a:hover) {
    color: var(--accent-text);
  }

  .doc :global(.box) {
    margin: 0.75rem 0;
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    background: rgb(var(--accent-rgb) / 0.06);
    border: 1px solid rgb(var(--accent-rgb) / 0.3);
  }

  .doc :global(.table-wrap) {
    overflow-x: auto;
    margin: 0.75rem 0;
  }

  .doc :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .doc :global(th),
  .doc :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .doc :global(th) {
    color: var(--text);
    background: rgb(var(--accent-rgb) / 0.08);
  }

  .doc-footer {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: var(--space-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .doc-footer a {
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }
</style>
