---
const contacts = [
  {
    type: 'Email',
    label: 'Professional inbox',
    description: 'Best option for project proposals, interviews, and long-form conversations.',
    value: 'alvaromoralesgonzalez92@gmail.com',
    href: 'mailto:alvaromoralesgonzalez92@gmail.com',
  },
  {
    type: 'Phone',
    label: 'Direct line',
    description: 'Available for quick calls, recruiter outreach, and follow-up conversations.',
    value: '+43 68181 741 443',
    href: 'tel:+4368181741443',
  },
  {
    type: 'LinkedIn',
    label: 'Professional profile',
    description: 'Useful for networking, work history, and keeping in touch professionally.',
    value: 'linkedin.com/in/alvaro-morales-dev',
    href: 'https://www.linkedin.com/in/%C3%A1lvaro-morales',
  },
];
---

<div class="container-section section-list accent-red">
  <div>
    <h2 class="section-title">Contact</h2>
  </div>

  <div class="card-list">
    {
      contacts.map((contact) => (
        <div class="card">
          <div class="card-pane">
            <div>
              <p class="card-eyebrow">{contact.type}</p>
              <h3 class="card-title">{contact.label}</h3>
            </div>
            <p class="card-text">{contact.description}</p>
          </div>

          <div class="card-pane card-pane-right">
            <div class="card-meta">Detail</div>
            <a
              class="card-link"
              href={contact.href}
              target={contact.type === 'LinkedIn' ? '_blank' : undefined}
              rel={contact.type === 'LinkedIn' ? 'noreferrer' : undefined}
            >
              {contact.value}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</div>
