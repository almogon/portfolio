---
const education = [
  {
    degree: "Bachelor's Degree in Software Engineering",
    institution: 'Universidad Politécnica de Madrid',
    period: '2010 – 2015',
    url: 'https://www.upm.es/internacional/Students/StudiesDegrees/OfficialUndergraduateDegrees/Relationed%20Articles?fmt=detail&prefmt=articulo&id=3388060c9abe0210VgnVCM10000009c7648a____',
    description:
      'Comprehensive education in software design, algorithms, data structures, systems programming, and software architecture. Final thesis focused on good architecture practices and how to choose the best option during development.',
  },
];
---

<div class="container-section section-list accent-green">
  <div>
    <h2 class="section-title">Education</h2>
  </div>

  <div class="card-list">
    {
      education.map((item) => (
        <div class="card">
          <div class="card-pane">
            <div>
              <p class="card-eyebrow">Bachelor's Degree</p>
              <h3 class="card-title">{item.degree.replace("Bachelor's Degree in ", '')}</h3>
            </div>
            <p class="card-text">{item.description}</p>
          </div>

          <div class="card-pane card-pane-right">
            <div class="card-meta">{item.period}</div>
            <a class="card-link" href={item.url} target="_blank" rel="noopener">
              {item.institution}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</div>
