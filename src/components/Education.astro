---
import { education } from '../data/education';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang).education;
---

<div class="container-section section-list accent-green">
  <div>
    <h2 class="section-title">{t.title}</h2>
  </div>

  <div class="card-list">
    {
      education.map((item) => (
        <div class="card">
          <div class="card-pane">
            <div>
              <p class="card-eyebrow">{item.degreeType[lang]}</p>
              <h3 class="card-title">{item.degree[lang]}</h3>
            </div>
            <p class="card-text">{item.description[lang]}</p>
          </div>

          <div class="card-pane card-pane-right">
            <div class="card-meta">{item.period}</div>
            <a class="card-link" href={item.url} target="_blank" rel="noopener">
              {item.institution}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</div>
