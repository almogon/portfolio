<style>
  /* Smooth transition for SVG rotation and color change */
  .rotating-svg {
    display: block;
    margin: 0 auto;
  }

  svg path {
    fill: white;
    transition: fill 0.5s ease;
  }

  .box-flag {
    display: flex;
    flex-direction: row;
    gap: 5px;
  }

  .navigation {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
  }

  #filter-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(14, 16, 15, 1) 0%,
      rgba(14, 16, 15, 0.78) 35%,
      rgba(14, 16, 15, 0.35) 70%,
      rgba(14, 16, 15, 0) 100%
    );
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .nav-content {
    position: relative;
    padding: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .menu-overlay {
  }

  .menu-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    text-align: center;
  }

  .menu-item {
    overflow: hidden;
    padding: 0px 10px;
  }

  .menu-item.experience:hover .menu-text {
    color: var(--c-blue); 
  }
  .menu-item.education:hover .menu-text {
    color: var(--c-green);
  }
  .menu-item.skills:hover .menu-text {
    color: var(--c-yellow);
  }
  .menu-item.references:hover .menu-text {
    color: var(--c-orange);
  }
  .menu-item.contact:hover .menu-text {
    color: var(--c-red);
  }

  .menu-item.active .menu-link {
    opacity: 1;
  }

  .menu-item.active.experience .menu-text {
    color: var(--c-blue);
  }

  .menu-item.active.education .menu-text {
    color: var(--c-green);
  }

  .menu-item.active.skills .menu-text {
    color: var(--c-yellow);
  }

  .menu-item.active.references .menu-text {
    color: var(--c-orange);
  }

  .menu-item.active.contact .menu-text {
    color: var(--c-red);
  }

  .menu-link {
    font-size: clamp(1.5rem, 10vw, 1rem);
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    line-height: 1;
    display: block;
    opacity: 0.7;
  }
  .menu-item:hover .menu-link {
    opacity: 1;
  }

  .logo-link {
    min-width: 200px;
    height: 2rem;
    display: flex;
    align-items: center;
    color: var(--text);
    opacity: 0.7;
  }

  .logo-link:hover {
    opacity: 1;
  }

  @media (min-width: var(--min-width-responsive-m)) {
    .nav-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 5%;
    }
    .logo-link {
      height: 2.5rem;
    }
  }
</style>
