---
const styleFlag = {
  objectFit: 'none',
  borderRadius: '20%',
  zoom: '25%',
  width: '120px',
  height: '80px',
};
const styleEnFlag = {
  ...styleFlag,
  objectPosition: '-570px -45px',
};
const styleEsFlag = {
  ...styleFlag,
  objectPosition: '-568px -233px',
};
const styleDeFlag = {
  ...styleFlag,
  objectPosition: '-370px -421px',
};
---

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuTextItems = document.querySelectorAll('.menu-item');
    const navigation = document.querySelector('.navigation');
    const anchorLinks = document.querySelectorAll('a[href^="#"]');
    const sections = Array.from(document.querySelectorAll('main section[id]'));
    const sectionColors = {
      'about-me': 'white',
      experience: 'var(--c-blue)',
      education: 'var(--c-green)',
      skills: 'var(--c-yellow)',
      references: 'var(--c-orange)',
      contact: 'var(--c-red)',
    };

    // Function to rotate the SVG
    let currentRotation = 0;
    let activeSectionId = 'about-me';

    const setHeaderAccent = (sectionId) => {
      activeSectionId = sectionId in sectionColors ? sectionId : 'about-me';

      const currentSvg = document.querySelector('.rotating-svg');
      if (currentSvg instanceof SVGSVGElement) {
        const svgPath = currentSvg.querySelector('path');
        if (svgPath instanceof SVGElement) {
          svgPath.style.fill = sectionColors[activeSectionId];
        }
      }

      menuTextItems.forEach((menuText) => {
        menuText.classList.remove('active');
        if (menuText.classList.contains(activeSectionId)) {
          menuText.classList.add('active');
        }
      });
    };

    const syncActiveSection = () => {
      if (!(navigation instanceof HTMLElement) || sections.length === 0) {
        return;
      }

      const triggerY = window.scrollY + navigation.getBoundingClientRect().height + 8;
      let currentSection = sections[0];

      sections.forEach((section) => {
        if (section.offsetTop <= triggerY) {
          currentSection = section;
        }
      });

      setHeaderAccent(currentSection.id);
    };

    menuTextItems.forEach((menuText) => {
      menuText.addEventListener('mouseenter', () => {
        const currentSvg = document.querySelector('.rotating-svg');
        if (!(currentSvg instanceof SVGSVGElement)) {
          return;
        }

        const svgPath = currentSvg.querySelector('path');
        if (!(svgPath instanceof SVGElement)) {
          return;
        }

        currentRotation += 180;
        currentSvg.style.transform = `rotate(${currentRotation}deg)`;
        currentSvg.style.transition = 'transform 0.5s ease';

        if (menuText.classList.contains('experience')) {
          svgPath.style.fill = sectionColors.experience;
        } else if (menuText.classList.contains('education')) {
          svgPath.style.fill = sectionColors.education;
        } else if (menuText.classList.contains('skills')) {
          svgPath.style.fill = sectionColors.skills;
        } else if (menuText.classList.contains('references')) {
          svgPath.style.fill = sectionColors.references;
        } else if (menuText.classList.contains('contact')) {
          svgPath.style.fill = sectionColors.contact;
        }
      });

      menuText.addEventListener('mouseleave', () => {
        setHeaderAccent(activeSectionId);
      });
    });

    anchorLinks.forEach((anchorLink) => {
      anchorLink.addEventListener('click', (event) => {
        if (!(anchorLink instanceof HTMLAnchorElement)) {
          return;
        }

        const hash = anchorLink.getAttribute('href');

        if (!hash || hash === '#') {
          return;
        }

        const target = document.querySelector(hash);
        if (!target || !(navigation instanceof HTMLElement)) {
          return;
        }

        event.preventDefault();
        const headerHeight = navigation.getBoundingClientRect().height;
        const extraOffset = 0;
        const targetTop = target.getBoundingClientRect().top + window.scrollY;

        window.scrollTo({
          top: targetTop - headerHeight - extraOffset,
          behavior: 'smooth',
        });

        setHeaderAccent(hash.slice(1));
        window.history.replaceState(null, '', hash);
      });
    });

    syncActiveSection();
    window.addEventListener('scroll', syncActiveSection, { passive: true });
  });
</script>

