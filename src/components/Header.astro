---
import { profile } from '../data/profile';
import { langs, localePath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang).nav;

const menuItems = [
  { id: 'experience', label: t.experience },
  { id: 'skills', label: t.skills },
  { id: 'education', label: t.education },
  { id: 'references', label: t.references },
  { id: 'contact', label: t.contact },
] as const;
---

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuTextItems = document.querySelectorAll('.menu-item');
    const navigation = document.querySelector('.navigation');
    const menuToggle = document.querySelector('.menu-toggle');
    const menuOverlay = document.querySelector('.menu-overlay');
    const mobileQuery = window.matchMedia('(max-width: 899px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const setMenuOpen = (open: boolean) => {
      if (!(menuToggle instanceof HTMLButtonElement) || !(navigation instanceof HTMLElement)) {
        return;
      }
      navigation.classList.toggle('menu-open', open);
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute(
        'aria-label',
        (open ? menuToggle.dataset.labelClose : menuToggle.dataset.labelOpen) ?? ''
      );
    };

    menuToggle?.addEventListener('click', () => {
      setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setMenuOpen(false);
      }
    });

    document.addEventListener('click', (event) => {
      if (
        navigation instanceof HTMLElement &&
        event.target instanceof Node &&
        !navigation.contains(event.target)
      ) {
        setMenuOpen(false);
      }
    });

    mobileQuery.addEventListener('change', (event) => {
      if (!event.matches) {
        setMenuOpen(false);
      }
    });

    menuOverlay?.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        setMenuOpen(false);
      }
    });
    const anchorLinks = document.querySelectorAll('a[href^="#"]');
    const sections = Array.from(document.querySelectorAll('main section[id]')).filter(
      (section) => section instanceof HTMLElement
    );
    // Function to rotate the SVG
    let currentRotation = 0;
    let activeSectionId = 'about-me';

    const getSectionColor = (sectionId: string) => {
      if (sectionId === 'experience') {
        return 'var(--c-blue)';
      }
      if (sectionId === 'education') {
        return 'var(--c-green)';
      }
      if (sectionId === 'skills') {
        return 'var(--c-yellow)';
      }
      if (sectionId === 'references') {
        return 'var(--c-orange)';
      }
      if (sectionId === 'contact') {
        return 'var(--c-red)';
      }
      return 'white';
    };

    const setHeaderAccent = (nextSectionId: string) => {
      activeSectionId = typeof nextSectionId === 'string' ? nextSectionId : 'about-me';

      const currentSvg = document.querySelector('.rotating-svg');
      if (currentSvg instanceof SVGSVGElement) {
        const svgPath = currentSvg.querySelector('path');
        if (svgPath instanceof SVGElement) {
          svgPath.style.fill = getSectionColor(activeSectionId);
        }
      }

      menuTextItems.forEach((menuText) => {
        menuText.classList.remove('active');
        if (menuText.classList.contains(activeSectionId)) {
          menuText.classList.add('active');
        }
      });
    };

    const syncActiveSection = () => {
      if (!(navigation instanceof HTMLElement) || sections.length === 0) {
        return;
      }

      const scrollBottom = window.scrollY + window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;
      if (scrollBottom >= documentHeight - 4) {
        setHeaderAccent(sections[sections.length - 1].id);
        return;
      }

      const triggerY = window.scrollY + navigation.getBoundingClientRect().height + 8;
      let currentSection = sections[0];

      sections.forEach((section) => {
        if (section.offsetTop <= triggerY) {
          currentSection = section;
        }
      });

      setHeaderAccent(currentSection.id);
    };

    menuTextItems.forEach((menuText) => {
      menuText.addEventListener('mouseenter', () => {
        const currentSvg = document.querySelector('.rotating-svg');
        if (!(currentSvg instanceof SVGSVGElement)) {
          return;
        }

        const svgPath = currentSvg.querySelector('path');
        if (!(svgPath instanceof SVGElement) || !(menuText instanceof HTMLElement)) {
          return;
        }

        if (!reducedMotion.matches) {
          currentRotation += 180;
          currentSvg.style.transform = `rotate(${currentRotation}deg)`;
          currentSvg.style.transition = 'transform 0.5s ease';
        }

        svgPath.style.fill = getSectionColor(menuText.dataset.section ?? '');
      });

      menuText.addEventListener('mouseleave', () => {
        setHeaderAccent(activeSectionId);
      });
    });

    anchorLinks.forEach((anchorLink) => {
      anchorLink.addEventListener('click', (event) => {
        if (!(anchorLink instanceof HTMLAnchorElement)) {
          return;
        }

        const hash = anchorLink.getAttribute('href');

        if (!hash || hash === '#') {
          return;
        }

        const target = document.querySelector(hash);
        if (!target || !(navigation instanceof HTMLElement)) {
          return;
        }

        event.preventDefault();
        const headerHeight = navigation.getBoundingClientRect().height;
        const extraOffset = 0;
        const targetTop = target.getBoundingClientRect().top + window.scrollY;

        window.scrollTo({
          top: targetTop - headerHeight - extraOffset,
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });

        setHeaderAccent(hash.slice(1));
        window.history.replaceState(null, '', hash);
      });
    });

    syncActiveSection();
    window.addEventListener('scroll', syncActiveSection, { passive: true });
  });
</script>

<header>
  <nav class="navigation">
    <div id="filter-background"></div>
    <div class="nav-content">
      <div class="brand">
        <div class="svg-container">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 512 512"
            width="50"
            height="50"
            class="rotating-svg"
            aria-hidden="true"
          >
            <g>
              <g>
                <path
                  d="M460.8,0C442.593,0,67.825,0,51.2,0C22.968,0,0,22.968,0,51.2c0,18.207,0,392.975,0,409.6C0,489.032,22.968,512,51.2,512
            c18.207,0,392.975,0,409.6,0c28.232,0,51.2-22.968,51.2-51.2c0-18.207,0-392.975,0-409.6C512,22.968,489.032,0,460.8,0z
             M159.289,477.867H51.2c-9.411,0-17.067-7.656-17.067-17.067V352.711h125.156V477.867z M159.289,318.578H34.133V193.422h125.156
            V318.578z M159.289,159.289H34.133V51.2c0-9.411,7.656-17.067,17.067-17.067h108.089V159.289z M318.578,477.867H193.422V352.711
            h125.156V477.867z M318.578,318.578H193.422V193.422h125.156V318.578z M318.578,159.289H193.422V34.133h125.156V159.289z
             M477.867,460.8c0,9.411-7.656,17.067-17.067,17.067H352.711V352.711h125.156V460.8z M477.867,318.578H352.711V193.422h125.156
            V318.578z M477.867,159.289H352.711V34.133H460.8c9.411,0,17.067,7.656,17.067,17.067V159.289z"
                ></path>
              </g>
            </g>
          </svg>
        </div>
        <a href="#about-me" class="logo-link" aria-label={`${profile.name}, ${t.backToTop}`}>
          {profile.name}
        </a>
      </div>

      <button
        type="button"
        class="menu-toggle"
        aria-controls="site-menu"
        aria-expanded="false"
        aria-label={t.openMenu}
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
      >
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
      </button>

      <div class="menu-overlay" id="site-menu">
        <div class="menu-container">
          <ul class="menu">
            {
              menuItems.map((item) => (
                <li class={`menu-item ${item.id}`} data-section={item.id}>
                  <a href={`#${item.id}`} class="menu-link">
                    <span class="menu-text">{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="lang-switch" aria-label={t.language}>
            {
              langs.map((code) => (
                <li>
                  <a
                    class="lang-link"
                    href={localePath(code)}
                    hreflang={code}
                    lang={code}
                    aria-current={code === lang ? 'page' : undefined}
                  >
                    {code.toUpperCase()}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  /* Smooth transition for SVG rotation and color change */
  .rotating-svg {
    display: block;
    margin: 0 auto;
  }

  svg path {
    fill: white;
    transition: fill 0.5s ease;
  }

  .navigation {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
  }

  #filter-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(14, 16, 15, 1) 0%,
      rgba(14, 16, 15, 0.78) 35%,
      rgba(14, 16, 15, 0.35) 70%,
      rgba(14, 16, 15, 0) 100%
    );
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .nav-content {
    position: relative;
    max-width: calc(var(--content-max) + 2 * var(--page-gutter));
    margin: 0 auto;
    padding: clamp(1rem, 2.5vw, 2rem) var(--page-gutter);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 1rem);
    min-width: 0;
  }

  .rotating-svg {
    width: clamp(36px, 5vw, 50px);
    height: auto;
  }

  .menu-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    text-align: center;
  }

  .menu-item {
    overflow: hidden;
    padding: 0 clamp(0.4rem, 1vw, 0.75rem);
  }

  .menu-item.experience:hover .menu-text,
  .menu-item.active.experience .menu-text {
    color: var(--c-blue);
  }
  .menu-item.education:hover .menu-text,
  .menu-item.active.education .menu-text {
    color: var(--c-green);
  }
  .menu-item.skills:hover .menu-text,
  .menu-item.active.skills .menu-text {
    color: var(--c-yellow);
  }
  .menu-item.references:hover .menu-text,
  .menu-item.active.references .menu-text {
    color: var(--c-orange);
  }
  .menu-item.contact:hover .menu-text,
  .menu-item.active.contact .menu-text {
    color: var(--c-red-text);
  }

  .menu-item.active .menu-link {
    opacity: 1;
  }

  .menu-link {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    line-height: 1;
    display: block;
    opacity: 0.7;
  }
  .menu-item:hover .menu-link {
    opacity: 1;
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: clamp(0.5rem, 1.5vw, 1rem);
    padding-left: clamp(0.5rem, 1.5vw, 1rem);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }

  .lang-link {
    display: block;
    padding: 0.35rem 0.45rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .lang-link:hover {
    color: var(--text);
  }

  .lang-link[aria-current='page'] {
    color: var(--background);
    background: var(--text);
  }

  .logo-link {
    display: flex;
    align-items: center;
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    color: var(--text);
    opacity: 0.7;
  }

  .logo-link:hover {
    opacity: 1;
  }

  /* Hamburger button, only shown on small screens */
  .menu-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: transparent;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .menu-toggle:hover,
  .menu-toggle:focus-visible {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
  }

  .menu-toggle-bar {
    position: absolute;
    left: 11px;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.3s ease, opacity 0.2s ease;
  }
  .menu-toggle-bar:nth-child(1) { top: 14px; }
  .menu-toggle-bar:nth-child(2) { top: 20px; }
  .menu-toggle-bar:nth-child(3) { top: 26px; }

  .menu-open .menu-toggle-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-open .menu-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .menu-open .menu-toggle-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Phone and portrait tablet: collapse the menu behind the hamburger */
  @media (max-width: 899px) {
    .menu-toggle {
      display: block;
    }

    .menu-overlay {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 0 var(--page-gutter) var(--space-xs);
      background: var(--background);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s;
    }

    .menu-open .menu-overlay {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s;
    }

    .menu-open #filter-background {
      background: var(--background);
    }

    .menu-container {
      flex-direction: column;
      align-items: stretch;
    }

    .lang-switch {
      margin: 0;
      padding: 1rem 0 0;
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      gap: 0.5rem;
    }

    .lang-link {
      padding: 0.55rem 0.9rem;
      font-size: 0.9rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .menu {
      width: 100%;
      flex-direction: column;
      text-align: left;
    }

    .menu-item {
      padding: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .menu-link {
      font-size: 1.25rem;
      padding: 1rem 0;
    }
  }
</style>
