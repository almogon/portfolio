---
const skillGroups = [
  {
    label: 'Frameworks',
    color: 'yellow',
    skills: ['Angular', 'Astro', 'Node.js', 'React', 'Spring Boot', 'Ionic'],
  },
  {
    label: 'Languages',
    color: 'yellow',
    skills: ['Python', 'Java', 'TypeScript', 'JavaScript', 'SQL'],
  },
  {
    label: 'Databases',
    color: 'yellow',
    skills: ['Oracle', 'MySQL', 'DynamoDB', 'MongoDB', 'PostgreSQL'],
  },
  {
    label: 'Cloud & DevOps',
    color: 'yellow',
    skills: ['AWS', 'Firebase', 'Oracle Apex', 'Vercel', 'Odoo.sh', 'Docker'],
  },
];
---

<div class="container-section section-list accent-yellow">
  <div>
    <h2 class="section-title">Skills</h2>
  </div>

  <p class="intro">
    As a full stack developer, I have had the privilege of working with a wide range of
    technologies across the entire stack.
  </p>

  <div class="skills-grid">
    {
      skillGroups.map((group) => (
        <div class={`card card-single accent-${group.color}`}>
          <div class="card-pane">
            <div class="group-header">
              <span class="group-dot" />
              <h3 class="group-label">{group.label}</h3>
            </div>
            <ul class="skill-list">
              {group.skills.map((skill) => (
                <li class="skill-tag">{skill}</li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .intro {
    opacity: 0.6;
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 60ch;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    width: 100%;
  }

  @media (max-width: 767px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  .group-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .group-dot {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex-shrink: 0;
    background: var(--accent);
  }

  .group-label {
    color: var(--accent);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-tag {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    background: rgb(var(--accent-rgb) / 0.08);
    border: 1px solid rgb(var(--accent-rgb) / 0.3);
    color: var(--accent);
    opacity: 0.8;
    transition: opacity 0.2s ease, transform 0.2s ease;
    cursor: default;
  }

  .skill-tag:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
</style>
