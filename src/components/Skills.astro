---
import { skillGroups } from '../data/skills';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang).skills;
---

<div class="container-section section-list accent-yellow">
  <div>
    <h2 class="section-title">{t.title}</h2>
    <p class="section-intro">{t.intro}</p>
  </div>

  <div class="skills-grid">
    {
      skillGroups.map((group) => (
        <div class:list={['card', 'card-single', { wide: group.wide }]}>
          <div class="card-pane">
            <div class="group-header">
              <span class="group-dot" />
              <h3 class="group-label">{group.label[lang]}</h3>
            </div>
            <ul class="tag-list">
              {group.skills.map((skill) => {
                const label = typeof skill === 'string' ? skill : skill[lang];
                return <li class:list={['tag', { 'tag-main': group.main?.includes(label) }]}>{label}</li>;
              })}
            </ul>
            {group.main && (
              <p class="main-legend">
                <span class="main-swatch" aria-hidden="true" />
                {t.main}
              </p>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    width: 100%;
  }

  .wide {
    grid-column: 1 / -1;
  }

  @media (max-width: 767px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  .group-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .group-dot {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex-shrink: 0;
    background: var(--accent);
  }

  .group-label {
    color: var(--accent-text);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .main-legend {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: -0.25rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .main-swatch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }

  .tag {
    transition: transform 0.2s ease;
  }

  .tag:hover {
    transform: translateY(-2px);
  }

  .tag-main {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--background);
  }
</style>
