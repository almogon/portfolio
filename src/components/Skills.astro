---
const skillGroups = [
  {
    label: 'Frameworks',
    color: 'yellow',
    skills: ['Angular', 'Astro', 'Node.js', 'React', 'Spring Boot', 'Ionic'],
  },
  {
    label: 'Languages',
    color: 'yellow',
    skills: ['Python', 'Java', 'TypeScript', 'JavaScript', 'SQL'],
  },
  {
    label: 'Databases',
    color: 'yellow',
    skills: ['Oracle', 'MySQL', 'DynamoDB', 'MongoDB', 'PostgreSQL'],
  },
  {
    label: 'Cloud & DevOps',
    color: 'yellow',
    skills: ['AWS', 'Firebase', 'Oracle Apex', 'Vercel', 'Odoo.sh', 'Docker'],
  },
];
---

<div class="container-section">
  <div>
    <h2 class="section-title">Skills</h2>
  </div>

  <p class="intro">
    As a full stack developer, I have had the privilege of working with a wide range of
    technologies across the entire stack.
  </p>

  <div class="skills-grid">
    {
      skillGroups.map((group) => (
        <div class={`skill-group group-${group.color}`}>
          <div class="group-header">
            <span class={`group-dot dot-${group.color}`} />
            <h3 class={`group-label label-${group.color}`}>{group.label}</h3>
          </div>
          <ul class="skill-list">
            {group.skills.map((skill) => (
              <li class={`skill-tag tag-${group.color}`}>{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<style>
  .intro {
    opacity: 0.6;
    font-size: 1.1rem;
    max-width: 60ch;
    margin-bottom: var(--space-md);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    width: 100%;
  }

  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  .skill-group {
    border-radius: 16px;
    padding: 1.5rem 2rem;
    border: 1px solid transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .group-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .group-dot {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .group-label {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-tag {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid transparent;
    transition: opacity 0.2s ease, transform 0.2s ease;
    cursor: default;
  }

  .skill-tag:hover {
    opacity: 1 !important;
    transform: translateY(-2px);
  }

  /* Yellow — Skills */
  .dot-yellow { background: var(--c-yellow); }
  .label-yellow { color: var(--c-yellow); }
  .group-yellow { border-color: rgba(255, 255, 0, 0.15); }
  .group-yellow:hover { background: rgba(255, 255, 0, 0.05); border-color: rgba(255, 255, 0, 0.3); }
  .tag-yellow {
    background: rgba(255, 255, 0, 0.08);
    border-color: rgba(255, 255, 0, 0.3);
    color: var(--c-yellow);
    opacity: 0.8;
  }

  /* Blue — Languages */
  .dot-blue { background: var(--c-blue); }
  .label-blue { color: var(--c-blue); }
  .group-blue { border-color: rgba(67, 114, 255, 0.15); }
  .group-blue:hover { background: rgba(67, 114, 255, 0.05); border-color: rgba(67, 114, 255, 0.3); }
  .tag-blue {
    background: rgba(67, 114, 255, 0.08);
    border-color: rgba(67, 114, 255, 0.3);
    color: var(--c-blue);
    opacity: 0.8;
  }

  /* Orange — Databases */
  .dot-orange { background: var(--c-orange); }
  .label-orange { color: var(--c-orange); }
  .group-orange { border-color: rgba(255, 102, 0, 0.15); }
  .group-orange:hover { background: rgba(255, 102, 0, 0.05); border-color: rgba(255, 102, 0, 0.3); }
  .tag-orange {
    background: rgba(255, 102, 0, 0.08);
    border-color: rgba(255, 102, 0, 0.3);
    color: var(--c-orange);
    opacity: 0.8;
  }

  /* Red — Cloud */
  .dot-red { background: var(--c-red); }
  .label-red { color: var(--c-red); }
  .group-red { border-color: rgba(204, 0, 0, 0.15); }
  .group-red:hover { background: rgba(204, 0, 0, 0.05); border-color: rgba(204, 0, 0, 0.3); }
  .tag-red {
    background: rgba(204, 0, 0, 0.08);
    border-color: rgba(204, 0, 0, 0.3);
    color: var(--c-red);
    opacity: 0.8;
  }
</style>
