---
import Icon from './Icon.astro';
import { profile, yearsOfExperience } from '../data/profile';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang).hero;
---

<div class="container-section">
  <h1 class="title">
    Software <span class="blue-green">Eng</span><span class="yellow-orange"
      >inee</span
    ><span class="red">r</span>
  </h1>
  <p class="subtitle">{t.subtitle}</p>

  <div class="intro-container">
    <div class="intro-borders intro-top-left"></div>
    <div class="intro-borders intro-bottom-right"></div>
    <div class="intro-text">
      <p>
        {t.intro(yearsOfExperience)}
        <br />{t.intro2}
      </p>
    </div>
  </div>

  <div class="cta">
    <a class="btn btn-primary" href="#contact">
      <Icon name="mail" />
      {t.cta}
    </a>
    <a class="btn" href={profile.linkedIn} target="_blank" rel="noopener noreferrer">
      <Icon name="linkedin" />
      LinkedIn
    </a>
    <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">
      <Icon name="github" />
      GitHub
    </a>
  </div>
</div>
<div class="scroll-indicator" aria-hidden="true">
  <span class="scroll-text">{t.scroll}</span>
  <span class="scroll-arrow"><Icon name="arrow-down" size={24} /></span>
</div>

<style>
  .title {
    font-size: var(--h1);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .title span {
    opacity: 0.8;
  }
  .title .blue-green {
    background: linear-gradient(to right, var(--c-blue), var(--c-green));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .title .yellow-orange {
    background: linear-gradient(to right, var(--c-yellow), var(--c-orange));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .title .red {
    color: var(--c-red);
  }
  .subtitle {
    font-size: var(--h2);
    line-height: 1.1;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
  }

  .intro-text {
    position: relative;
    padding: clamp(0.5rem, 2vw, 1.25rem);
    text-align: end;
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem);
    line-height: 1.6;
  }
  .intro-container {
    position: relative;
    display: inline-block;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    width: 100%;
  }

  .intro-borders {
    position: absolute;
    pointer-events: none;
  }

  /* Top and Left Borders */
  .intro-top-left {
    top: 0;
    left: 0;
    width: 60%;
    height: 60%;
  }

  .intro-top-left::before,
  .intro-top-left::after {
    content: '';
    position: absolute;
    background-color: white;
  }
  .intro-top-left::before {
    width: 60%;
    height: 2px;
    top: 0;
    left: 0;
  }
  .intro-top-left::after {
    width: 2px;
    height: 60%;
    top: 0;
    left: 0;
  }

  /* Bottom and Right Borders */
  .intro-bottom-right {
    bottom: 0;
    right: 0;
    width: 60%;
    height: 60%;
  }

  .intro-bottom-right::before,
  .intro-bottom-right::after {
    content: '';
    position: absolute;
    background-color: white;
  }
  .intro-bottom-right::before {
    width: 60%;
    height: 2px;
    bottom: 0;
    right: 0;
  }
  .intro-bottom-right::after {
    width: 2px;
    height: 60%;
    bottom: 0;
    right: 0;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: var(--space-sm);
  }

  @media (max-width: 767px) {
    .cta {
      justify-content: flex-start;
    }
  }

  .scroll-indicator {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    z-index: 1;
    opacity: 0;
    animation: fade-in 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: 1s;
  }

  .scroll-text {
    font-size: 0.875rem;
    opacity: 0.7;
    letter-spacing: 0.05em;
  }

  .scroll-arrow {
    animation: jump 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes jump {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  @keyframes fade-in {
    0% {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
