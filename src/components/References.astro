---
const references = [
  {
    name: 'Alberto Salamanca Rico',
    role: 'Direct Manager',
    company: 'Babel S.I',
    description: 'Can speak about my growth and adaptability.',
    email: '',
    linkedIn: 'https://es.linkedin.com/in/albertosalamanca',
  },
  {
    name: 'Senen González',
    role: 'Senior expert for Data Management and Analysis',
    company: 'Track Machines Connected',
    description: 'Can speak about backend design decisions, mentoring, and impact on the team.',
    email: 'senen.gonzalez@tmc.at',
    linkedIn: 'https://at.linkedin.com/in/dr-senen-gonzalez-62394b172'
  },
  {
    name: 'Sara Mari-Strasser',
    role: 'CEO',
    company: 'Schrankerl',
    description: 'Can provide context on communication, ownership, and delivery under deadlines as a tech leader.',
    email: 'sara@schrankerl.at',
    linkedIn: 'https://at.linkedin.com/in/sara-mari-strasser'
  },
];
---

<div class="container-section references-section">
  <div>
    <h2 class="section-title">References</h2>
  </div>

  {
    references.map((reference) => (
      <div class="box-reference">
        <div class="box-pane box-pane-left">
          <div>
            <p class="box-eyebrow">{reference.role}</p>
            <h3>{reference.name}</h3>
          </div>
          <p>{reference.description}</p>
        </div>

        <div class="box-pane box-pane-right">
          <div class="reference-header">
            <div class="reference-company">{reference.company}</div>
            <div class="reference-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path
                  d="M7 11C8.65685 11 10 9.65685 10 8C10 6.34315 8.65685 5 7 5C5.34315 5 4 6.34315 4 8C4 9.65685 5.34315 11 7 11Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
                <path
                  d="M17 10C18.3807 10 19.5 8.88071 19.5 7.5C19.5 6.11929 18.3807 5 17 5C15.6193 5 14.5 6.11929 14.5 7.5C14.5 8.88071 15.6193 10 17 10Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
                <path
                  d="M2.5 18C2.5 15.7909 4.29086 14 6.5 14H7.5C9.70914 14 11.5 15.7909 11.5 18"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
                <path
                  d="M13.5 18C13.5 16.067 15.067 14.5 17 14.5C18.933 14.5 20.5 16.067 20.5 18"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
              </svg>
            </div>
          </div>

          <div class="reference-links">
            {
              reference.email && (
                <a class="reference-link" href={`mailto:${reference.email}`}>
                  <span class="reference-link-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                      <path
                        d="M4 7H20C20.5523 7 21 7.44772 21 8V16C21 16.5523 20.5523 17 20 17H4C3.44772 17 3 16.5523 3 16V8C3 7.44772 3.44772 7 4 7Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <path
                        d="M4 8L12 13L20 8"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  <span>{reference.email}</span>
                </a>
              )
            }

            {
              reference.linkedIn && (
                <a
                  class="reference-link"
                  href={reference.linkedIn}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="reference-link-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                      <path
                        d="M7 9H4V20H7V9Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M5.5 6.5C6.32843 6.5 7 5.82843 7 5C7 4.17157 6.32843 3.5 5.5 3.5C4.67157 3.5 4 4.17157 4 5C4 5.82843 4.67157 6.5 5.5 6.5Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <path
                        d="M12 20V13.5C12 11.8431 13.3431 10.5 15 10.5C16.6569 10.5 18 11.8431 18 13.5V20"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M12 14V9H15V10.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  <span>LinkedIn</span>
                </a>
              )
            }
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .references-section {
    align-items: flex-start;
    justify-content: flex-start;
    width: 90%;
    gap: 3rem;
  }

  .box-reference {
    width: 100%;
    border: 1px solid rgba(255, 102, 0, 0.8);
    border-radius: 20px;
    display: grid;
    grid-template-columns: 40% 60%;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .box-reference:hover {
    background: rgba(255, 102, 0, 0.08);
    border-color: var(--c-orange);
  }

  .box-pane {
    padding: 1rem 3rem 1.5rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .box-pane-left h3 {
    font-size: 4vh;
    font-weight: 600;
    opacity: 0.8;
  }

  .box-pane-left p {
    opacity: 0.8;
    font-weight: 500;
    font-family: monospace;
    text-align: justify;
  }

  .box-eyebrow {
    color: var(--c-orange);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .box-pane-right {
    justify-content: center;
    gap: 0.5rem;
  }

  .reference-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .reference-company {
    font-size: 1.5rem;
    opacity: 0.7;
  }

  .reference-icon {
    color: var(--c-orange);
    opacity: 0.85;
    flex-shrink: 0;
  }

  .reference-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .reference-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    opacity: 0.85;
    text-decoration: none;
    font-size: clamp(1rem, 2vw, 1.25rem);
    word-break: break-word;
    width: fit-content;
    border-bottom: 1px solid rgba(255, 102, 0, 0.35);
    transition: opacity 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .reference-link-icon {
    color: var(--c-orange);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .reference-link:hover {
    opacity: 1;
    color: var(--c-orange);
    border-color: var(--c-orange);
  }

  @media (max-width: 900px) {
    .box-reference {
      grid-template-columns: 1fr;
    }

    .box-pane {
      padding: 1.5rem;
    }
  }
</style>
