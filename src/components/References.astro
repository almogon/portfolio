---
import Icon from './Icon.astro';
import { references } from '../data/references';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang).references;
---

<div class="container-section section-list accent-orange">
  <div>
    <h2 class="section-title">{t.title}</h2>
    <p class="section-intro">{t.intro}</p>
  </div>

  <div class="references-grid">
    {
      references.map((reference) => (
        <article class="card card-single">
          <div class="card-pane">
            <div>
              <p class="card-eyebrow">{reference.role[lang]}</p>
              <h3 class="card-title">{reference.name}</h3>
            </div>
            <p class="card-text">{reference.description[lang]}</p>
            <div class="reference-footer">
              <span class="reference-company">
                <span class="reference-icon">
                  <Icon name="people" size={20} />
                </span>
                {reference.company}
              </span>
              <div class="reference-links">
                {reference.email && (
                  <a
                    class="card-link reference-link"
                    href={`mailto:${reference.email}`}
                    aria-label={t.emailTo(reference.name)}
                  >
                    <Icon name="mail" />
                    <span>{reference.email.split('@')[0]}<wbr />@{reference.email.split('@')[1]}</span>
                  </a>
                )}
                <a
                  class="card-link reference-link"
                  href={reference.linkedIn}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={t.onLinkedIn(reference.name)}
                >
                  <Icon name="linkedin" />
                  LinkedIn
                </a>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</div>

<style>
  .references-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
    width: 100%;
  }

  @media (max-width: 1023px) {
    .references-grid {
      grid-template-columns: 1fr;
    }
  }

  .references-grid .card-text {
    text-align: left;
    flex-grow: 1;
  }

  .reference-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--accent-rgb) / 0.2);
  }

  .reference-company {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-grey);
  }

  .reference-icon {
    color: var(--accent-text);
    display: inline-flex;
  }

  .reference-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
  }

  .reference-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    overflow-wrap: normal;
  }

  .reference-link svg {
    flex-shrink: 0;
  }
</style>
