---
const experiences = [
  {
    company: 'Schrankerl',
    url: 'https://schrankerl.at',
    summary:
      'Company that offers fresh and varied food for companies, preparing custom menus based on preferences and profiles.',
    role: 'Software engineer',
    period: 'Feb 2022 / Present',
    description:
      'Tech leader in charge of supervising my team members, ensuring that tasks are completed on time. I make decisions about our tools and software architecture. I also perform maintenance and quality tasks on our systems. The environment is Odoo.sh, with a backend architecture based on modules, and the frontend is developed using the latest version of Angular.',
  },
  {
    company: 'Solvistas',
    url: 'https://www.solvistas.com/de',
    summary:
      'Provides data science solutions and services in classic disciplines such as analytics, data management, business intelligence and digitalization.',
    role: 'Software engineer',
    period: 'Sep 2020 / Feb 2022',
    description:
      'Participated in many projects, working mainly with Java Spring and Angular. Backend tasks included creating REST APIs, testing and documentation. Design and implementation of new components, models and views for the web application using Angular and TypeScript. Worked with React Native implementing the Relv.io app. Led the team, taking architecture decisions, managing team tasks and implementing features as well. The environment was based on the Firebase cloud. Worked as Scrum Master for half a year.',
  },
  {
    company: 'TMC',
    url: 'https://www.tmconnected.com/en/home/',
    summary: 'Focused on solutions for rail infrastructure and rail traffic management.',
    role: 'Full Stack Developer',
    period: 'Jul 2018 / Sep 2020',
    description:
      'Design and development of several projects in backend and frontend. Backend tasks can be summarized as the creation of web services using REST protocols for communication and the implementation of cloud data structures using Amazon Web Services (AWS) tools and environment. Design and implementation of new views and components for the web application using Angular and TypeScript.',
  },
  {
    company: 'Babel S.I',
    url: 'https://babelgroup.com/en/',
    summary: 'Helps companies improve their business processes and digital transformation.',
    role: 'Full Stack Developer',
    period: 'Sep 2015 / Jul 2018',
    description:
      'Design and implementation of services using Spring Boot and Maven for backend operations; modelling and creating new databases in Oracle; implementation of hybrid apps based on microservices and components using Ionic.',
  },
  {
    company: 'Babel S.I',
    url: 'https://babelgroup.com/en/',
    summary: 'Helps companies improve their business processes and digital transformation.',
    role: 'Intern',
    period: 'Mar 2015 / Sep 2015',
    description:
      'Worked on several projects learning the basics of delivering results, where the most important actions were: defining when a project starts, deciding the best technologies and architecture, and implementing the resulting services in frontend and backend.',
  },
];
---

<div class="container-section section-list accent-blue">
  <div>
    <h2 class="section-title">Experience</h2>
  </div>

  <div class="card-list">
    {
      experiences.map((item) => (
        <div class="card">
          <a
            class="card-pane company-link"
            href={item.url}
            target="_blank"
            rel="noopener"
          >
            <div class="company-header">
              <h3 class="card-title">{item.company}</h3>
              <span class="link-icon" aria-hidden="true">
                <svg
                  width="32"
                  height="32"
                  viewBox="0 0 24 22"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M14 12C14 14.7614 11.7614 17 9 17H7C4.23858 17 2 14.7614 2 12C2 9.23858 4.23858 7 7 7H7.5M10 12C10 9.23858 12.2386 7 15 7H17C19.7614 7 22 9.23858 22 12C22 14.7614 19.7614 17 17 17H16.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
            </div>
            <p class="card-text">{item.summary}</p>
          </a>

          <div class="card-pane">
            <div class="role-header">
              <h4 class="card-meta">{item.role}</h4>
              <span class="role-period">{item.period}</span>
            </div>
            <p class="card-body">{item.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .company-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .link-icon {
    display: inline-flex;
    color: var(--text-grey);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .company-link:hover .link-icon,
  .company-link:focus-visible .link-icon {
    opacity: 1;
  }

  /* Touch devices have no hover: keep the link hint visible */
  @media (hover: none) {
    .link-icon {
      opacity: 0.7;
    }
  }

  .role-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .role-period {
    font-size: 0.95rem;
    opacity: 0.6;
    white-space: nowrap;
  }
</style>
