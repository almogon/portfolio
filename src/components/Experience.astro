<style>
  :root {
    --text-company: #cccccc;
    --text-company-info: #5e636e;
    --text-other: #8f96a3;
  }

  button {
    padding: 3px;
    margin-bottom: 1px;
    width: 85%;
    background-color: var(--c-blue);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 0.75rem;
    cursor: pointer;
    transition:
      background-color 0.3s,
      transform 0.3s;
  }

  button:hover {
    background-color: darken(var(--c-blue), 10%);
    /* transform: scale(1.05); */
  }

  button:active {
    background-color: darken(var(--c-blue), 20%);
    transform: scale(0.95);
  }
  .container-section {
    align-items: flex-start;
    justify-content: flex-start;
    width: 90%;
    gap: 3rem;
  }
  .box-experience {
    min-width: 100%;
    border: 1px solid var(--c-blue);
    border-radius: 20px;
    display: grid;
    grid-template-columns: 40% 60%;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.2);
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    /* grid-template-rows: 1fr 70px; */
  }

  .box-experience:hover {
    background: rgba(67, 114, 255, 0.08);
    border-color: var(--c-blue);
    box-shadow: 0 28px 96px rgba(0, 0, 0, 0.24);
  }

  @keyframes border-move {
    0% {
      border-image: linear-gradient(90deg, var(--c-blue) 0%, transparent 100%) 1;
      border-radius: 20px;
    }
    25% {
      border-image: linear-gradient(180deg, var(--c-blue) 0%, transparent 100%)
        1;
      border-radius: 20px;
    }
    50% {
      border-image: linear-gradient(270deg, var(--c-blue) 0%, transparent 100%)
        1;
      border-radius: 20px;
    }
    75% {
      border-image: linear-gradient(360deg, var(--c-blue) 0%, transparent 100%)
        1;
      border-radius: 20px;
    }
    100% {
      border-image: linear-gradient(90deg, var(--c-blue) 0%, transparent 100%) 1;
      border-radius: 20px;
    }
  }

  .box-section {
    padding: 1rem 3rem 1.5rem 3rem;
    display: grid;
  }

  #box-left h3 {
    font-size: 4vh;
    font-weight: 600;
    opacity: 0.8;
  }
  #box-left p {
    opacity: 0.8;
    font-weight: 500;
    font-family: monospace;
  }

  #box-left > a {
    display: grid;
    row-gap: 1rem;
    margin-bottom: 10px;
  }
  #box-rigth {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  #box-rigth > div {
    font-size: 1.5rem;
    opacity: 0.7;
  }
  #box-rigth > p {
    opacity: 0.5;
  }

  .link-icon {
    opacity: 0;
    transition: opacity 0.3s;
  }

  #box-left:hover {
    cursor: pointer;
  }

  #box-left:hover .link-icon {
    opacity: 1;
  }

  p {
    text-align: justify;
  }
</style>
