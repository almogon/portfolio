---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang).footer;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-section footer-content">
    <p>© {year} {profile.name}</p>
    <p class="footer-built">
      {t.builtWith} ·
      <a class="footer-link" href={profile.repository} target="_blank" rel="noopener noreferrer">
        <Icon name="github" size={14} />
        {t.source}
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: var(--space-sm) 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer-content {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }

  .footer-built {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-grey);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--text);
    border-color: var(--text);
  }
</style>
